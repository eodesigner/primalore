---
import Base from '../layouts/Base.astro';
---
<Base title="Search" description="Search every published Primalore guide.">
  <section class="page-head accent">
    <h1>Search the guides</h1>
    <p>Search guides, checklists and tips by keyword.</p>
  </section>
  <div id="search"></div>
  <noscript><p class="meta">Search needs JavaScript.</p></noscript>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (window.PagefindUI) {
        var ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
        var q = new URLSearchParams(location.search).get('q');
        if (q) ui.triggerSearch(q);
      } else {
        document.getElementById('search').textContent = 'Search is only available on the published site.';
      }
    });
  </script>
</Base>
