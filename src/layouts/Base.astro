---
import '../styles/global.css';
import { categories } from '../data/categories';
interface Props { title?: string; description?: string; activeCategory?: string }
const { title, description = 'Primalore: verified survival knowledge for a harder world.', activeCategory } = Astro.props;
const full = title ? `${title} | Primalore` : 'Primalore';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{full}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply the saved theme before first paint. No saved choice means follow the system.
      try { var t = localStorage.getItem('primalore-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site wrap">
      <nav class="topbar" aria-label="Main">
        <div class="left">
          <a class="pill" href="/#latest">Guides</a>
          <a class="pill" href="/method/">How we verify</a>
        </div>
        <a class="brand" href="/">primalore</a>
        <div class="right">
          <a class="pill" href="/search/">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>Search</a>
          <button class="pill icon-btn" id="theme-toggle" type="button" aria-label="Switch between dark and light theme">
            <svg class="theme-dark-only" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/></svg>
            <svg class="theme-light-only" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="pill accent" href="/sources/">Sources</a>
        </div>
      </nav>
      <nav class="cats" aria-label="Categories">
        <ul>
          {categories.map((c) => (
            <li><a href={`/category/${c.slug}/`} aria-current={activeCategory === c.slug || path.startsWith(`/category/${c.slug}/`) ? 'page' : undefined}>{c.name}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site wrap">
      <div class="inner">
        <span class="name">primalore</span>
        <p>Information for education only. It does not replace professional medical or emergency advice. In an emergency in the UK, dial 999.</p>
        <div class="links">
          <a href="/method/">How we verify</a>
          <a href="/sources/">Sources</a>
          <a href="https://github.com/eodesigner/primalore/issues/new" rel="noopener">Report a mistake</a>
          <a href="https://github.com/eodesigner/primalore" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var current = root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('primalore-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
